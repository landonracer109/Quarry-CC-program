-- quarry_control.lua
-- Runs on a Computer (NOT a turtle) with a wireless modem attached.
-- Coordinates a fleet of turtles (running quarry_turtle.lua) to mine
-- chunk after chunk in a line: all turtles mine one chunk together,
-- then all advance to the next chunk together.

local PROTOCOL = "chunkquarry"

local opened = false
for _, side in ipairs(peripheral.getNames()) do
  if peripheral.getType(side) == "modem" then
    rednet.open(side)
    opened = true
  end
end
if not opened then
  error("No modem attached to this computer! Attach a wireless modem and rerun.")
end

print("=== Chunk Quarry Control ===")
io.write("Chunk length (blocks per tunnel, usually 16): ")
local length = tonumber(read()) or 16
io.write("Depth (layers to mine down): ")
local depth = tonumber(read()) or 60
io.write("Number of chunks to mine (0 = run until stopped): ")
local chunks = tonumber(read()) or 0

local turtles = {} -- [laneId] = {computerId=, status=, chunk=, fuel=}

local function countTurtles()
  local n = 0
  for _ in pairs(turtles) do n = n + 1 end
  return n
end

local function draw(headerExtra)
  term.clear()
  term.setCursorPos(1, 1)
  print("=== Chunk Quarry Control ===")
  print("length=" .. length .. "  depth=" .. depth .. "  chunks=" .. (chunks == 0 and "infinite" or chunks))
  print(string.rep("-", 50))
  local ids = {}
  for id in pairs(turtles) do table.insert(ids, id) end
  table.sort(ids)
  for _, id in ipairs(ids) do
    local t = turtles[id]
    print(string.format("Turtle %2d | chunk %3d | fuel %6s | %s",
      id, t.chunk or 0, tostring(t.fuel or "?"), t.status or ""))
  end
  print(string.rep("-", 50))
  if headerExtra then print(headerExtra) end
end

-- Phase 1: collect registrations
draw("Power on turtles now (run: quarry_turtle <laneId> on each).")
print("Press ENTER once all expected turtles have checked in.")

local collecting = true
parallel.waitForAny(
  function()
    while collecting do
      local senderId, msg = rednet.receive(PROTOCOL, 1)
      if msg and msg.cmd == "hello" then
        turtles[msg.id] = turtles[msg.id] or {}
        turtles[msg.id].computerId = senderId
        turtles[msg.id].status = "ready"
        draw("Press ENTER once all expected turtles have checked in.")
      end
    end
  end,
  function()
    read()
    collecting = false
  end
)

if countTurtles() == 0 then
  print("No turtles checked in. Exiting.")
  return
end

-- Phase 2: send start config to every registered turtle
for id, t in pairs(turtles) do
  rednet.send(t.computerId, { cmd = "start", length = length, depth = depth, chunks = chunks }, PROTOCOL)
  t.status = "starting"
end

-- Phase 3: monitor, advance chunks, allow early stop
local currentChunk = 1
local doneThisChunk = {}
local running = true

parallel.waitForAny(
  function()
    while running do
      local senderId, msg = rednet.receive(PROTOCOL, 2)
      if msg then
        -- allow late-joining turtles too
        turtles[msg.id] = turtles[msg.id] or { status = "ready" }
        local t = turtles[msg.id]
        t.computerId = senderId

        if msg.cmd == "progress" then
          t.chunk = msg.chunk
          t.fuel = msg.fuel
          t.status = "mining layer " .. tostring(msg.layer)
        elseif msg.cmd == "chunk_done" then
          t.status = "chunk " .. msg.chunk .. " done, waiting"
          doneThisChunk[msg.id] = msg.chunk
        elseif msg.cmd == "error" then
          t.status = "ERROR: " .. tostring(msg.msg)
        end
      end

      local allDone, count = true, 0
      for id in pairs(turtles) do
        count = count + 1
        if doneThisChunk[id] ~= currentChunk then allDone = false end
      end

      if allDone and count > 0 then
        if chunks ~= 0 and currentChunk >= chunks then
          for id, t in pairs(turtles) do
            rednet.send(t.computerId, { cmd = "stop" }, PROTOCOL)
          end
          running = false
        else
          for id, t in pairs(turtles) do
            rednet.send(t.computerId, { cmd = "next_chunk" }, PROTOCOL)
            t.status = "advancing to chunk " .. (currentChunk + 1)
          end
          currentChunk = currentChunk + 1
        end
      end

      draw("Chunk " .. currentChunk .. " in progress. Type 's' + ENTER to stop early.")
    end
  end,
  function()
    while running do
      local line = read()
      if line == "s" then
        for id, t in pairs(turtles) do
          rednet.send(t.computerId, { cmd = "stop" }, PROTOCOL)
        end
        running = false
      end
    end
  end
)

draw("All done / stopped.")
