-- quarry_control (control computer) -- ComputerCraft 1.63
-- Runs on a Computer (NOT a turtle) with a wireless modem attached.
-- Registers the mining turtles, starts them, and moves the whole fleet to
-- the next chunk once every turtle has finished the current one.
--
-- Start order: service turtle, then all miners, then this.
-- Keys: ENTER = start mining once all turtles are registered
--       S     = stop (turtles finish their current pass and go home)

local PROTOCOL = "chunkquarry" -- control computer <-> miners

local opened = false
for _, side in ipairs(rs.getSides()) do
  if peripheral.getType(side) == "modem" then
    rednet.open(side)
    opened = true
  end
end
if not opened then
  error("No modem attached! Attach a wireless modem and rerun.")
end

term.clear()
term.setCursorPos(1, 1)
print("=== Chunk Quarry Control ===")
io.write("Chunk length (blocks per lane, usually 16): ")
local length = tonumber(read()) or 16
io.write("Depth (layers to mine down): ")
local depth = tonumber(read()) or 60
io.write("Chunks to mine (0 = until stopped): ")
local chunks = tonumber(read()) or 0

-- State ---------------------------------------------------------------------
local miners = {}        -- [lane] = { id=, status=, chunk=, y=, fuel= }
local done = {}          -- [lane] = last chunk that lane finished
local stopped = {}       -- [lane] = true once we've told it to stop
local started = false
local stop_requested = false
local finished = false   -- no more chunks: answer everything with "stop"
local current_chunk = 1
local notice = ""

local function sorted_lanes()
  local lanes = {}
  for lane in pairs(miners) do table.insert(lanes, lane) end
  table.sort(lanes)
  return lanes
end

-- The screen is 51x19, so: 1 header line, up to 16 lanes, 2 footer lines.
local function draw()
  term.clear()
  term.setCursorPos(1, 1)
  local header = string.format("L=%d D=%d chunk %d/%s", length, depth,
    current_chunk, chunks == 0 and "inf" or tostring(chunks))
  if stop_requested then header = header .. "  STOPPING" end
  print(header)
  for _, lane in ipairs(sorted_lanes()) do
    local m = miners[lane]
    print(string.format("%2d c%-3d y%-4s f%-6s %s", lane, m.chunk or 0,
      tostring(m.y or 0), tostring(m.fuel or "?"), m.status or ""))
  end
  local _, h = term.getSize()
  term.setCursorPos(1, h - 1)
  term.write(notice)
  term.setCursorPos(1, h)
  if not started then
    term.write("ENTER = start (" .. #sorted_lanes() .. " registered)")
  elseif finished or stop_requested then
    term.write("Finishing up...")
  else
    term.write("S = stop")
  end
end

local function send(lane, msg)
  rednet.send(miners[lane].id, msg, PROTOCOL)
end

local function start_msg(lane)
  return { cmd = "start", id = lane, length = length, depth = depth }
end

local function tell_stop(lane)
  send(lane, { cmd = "stop", id = lane })
  stopped[lane] = true
  miners[lane].status = "stopped"
end

local function all_stopped()
  for lane in pairs(miners) do
    if not stopped[lane] then return false end
  end
  return true
end

-- Called when a lane reports chunk_done: if everyone is done, either move
-- the fleet to the next chunk or finish.
local function try_advance()
  for lane in pairs(miners) do
    if (done[lane] or 0) < current_chunk then return end
  end
  if stop_requested or (chunks ~= 0 and current_chunk >= chunks) then
    finished = true
    for lane in pairs(miners) do tell_stop(lane) end
  else
    current_chunk = current_chunk + 1
    for lane in pairs(miners) do
      send(lane, { cmd = "next_chunk", id = lane, chunk = current_chunk })
      miners[lane].status = "to chunk " .. current_chunk
    end
  end
end

local function handle(sender, msg)
  if type(msg) ~= "table" or type(msg.id) ~= "number" then return end
  local lane = msg.id
  local m = miners[lane]

  if msg.cmd == "hello" then
    if not started then
      if m and m.id ~= sender then
        notice = "Two turtles claim lane " .. lane .. "! Check IDs."
      end
      miners[lane] = m or {}
      miners[lane].id = sender
      miners[lane].status = "registered"
      send(lane, { cmd = "registered", id = lane })
    elseif m and m.id == sender then
      send(lane, start_msg(lane)) -- it missed the first start message
    end
    return
  end

  -- everything else must come from a registered turtle
  if not m or m.id ~= sender then return end

  if msg.cmd == "progress" then
    m.chunk, m.y, m.fuel = msg.chunk, msg.y, msg.fuel
    if stop_requested or finished then
      tell_stop(lane)
    else
      m.status = "mining pass " .. tostring(msg.pass)
      send(lane, { cmd = "go", id = lane })
    end
  elseif msg.cmd == "chunk_done" then
    done[lane] = math.max(done[lane] or 0, msg.chunk)
    m.chunk = msg.chunk
    if finished or stop_requested then
      tell_stop(lane)
    elseif msg.chunk < current_chunk then
      -- it missed the next_chunk message; repeat it
      send(lane, { cmd = "next_chunk", id = lane, chunk = current_chunk })
    else
      m.status = "chunk " .. msg.chunk .. " done, waiting"
      try_advance()
    end
  end
end

-- Main ----------------------------------------------------------------------
local function network_loop()
  while true do
    local sender, msg = rednet.receive(PROTOCOL, 1)
    if msg then handle(sender, msg) end
    if started and next(miners) and all_stopped() then return end
    draw()
  end
end

local function key_loop()
  while true do
    local event, key = os.pullEvent("key")
    if key == keys.enter and not started then
      if next(miners) then
        started = true
        notice = ""
        for lane, m in pairs(miners) do
          send(lane, start_msg(lane))
          m.status = "starting"
        end
      else
        notice = "No turtles registered yet."
      end
      draw()
    elseif key == keys.s and started and not stop_requested then
      stop_requested = true
      notice = "Stop requested."
      draw()
    end
  end
end

draw()
parallel.waitForAny(network_loop, key_loop)

term.clear()
term.setCursorPos(1, 1)
print("All turtles told to stop. They'll return to their")
print("starting spots. Stop the service turtle (Ctrl+T)")
print("once they're all home.")
