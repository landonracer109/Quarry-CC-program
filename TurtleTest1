-- quarry_turtle (mining turtle) -- ComputerCraft 1.63
-- Usage: quarry_turtle <laneId>      (laneId 0..15)
--
-- Mines its own 1-wide lane of the current chunk, 3 layers per pass
-- (digs up and down as it goes). When it needs fuel or its inventory is
-- full it goes back to the chunk entrance and calls the service turtle.
--
-- SETUP (per turtle):
--   * 16 miners in a flush row, all facing the tunnel direction.
--     Lane 0 is the LEFTMOST; lane numbers increase to the RIGHT
--     (standing behind the turtles, looking the way they face).
--   * Wireless modem on every turtle.
--   * Lane 0 only: Spot Loaders in slot 15.
--   * Start order: service turtle, then all miners, then the control computer.

local args = { ... }
local LANE = tonumber(args[1])
if not LANE then
  local name = shell and shell.getRunningProgram() or "quarry_turtle"
  print("Usage: " .. name .. " <laneId>   (lane 0..15)")
  return
end

local PROTOCOL = "chunkquarry"          -- control computer <-> miners
local SERVICE_PROTOCOL = "chunkservice" -- miners <-> service turtle

local function open_modem()
  for _, side in ipairs(rs.getSides()) do
    if peripheral.getType(side) == "modem" then
      rednet.open(side)
      return true
    end
  end
  return false
end

if not open_modem() then
  error("No modem attached! Attach a wireless modem and rerun.")
end

-- Prints a message and sends it (plus an optional short status) to the
-- control computer's dashboard. Fire-and-forget: broadcasting never waits,
-- and a lost update only means the display is briefly out of date.
local STATUS_PROTOCOL = "chunkstatus"
local function say(text, state)
  if text then print(text) end
  rednet.broadcast({ cmd = "status", id = LANE, text = text, state = state }, STATUS_PROTOCOL)
end

-- IMPORTANT: a turtle throws away rednet messages that arrive while it is
-- moving, turning or digging. So every exchange below is "keep re-sending
-- until the other side answers", and we only wait for replies while parked.

-- Config / state ------------------------------------------------------------
local LOADER_SLOT = 15
local FUEL_BUFFER = 20
local UNBREAKABLE_TRIES = 5 -- failed digs in a row before we call it bedrock

-- z = blocks forward from the start, y = 0 at start (negative = below)
local y, z, facing = 0, 0, 0 -- facing: 0 = mining direction, 2 = back toward base

local controller_id
local length, depth
local max_chunks = 0 -- 0 = until stopped
local no_next_loader = false -- lane 0 couldn't load the next chunk: run must end
local z_base, chunk_num = 0, 1
-- unique per program run, so the service turtle can tell a restart apart
local session = os.getComputerID() .. ":" .. os.day() .. ":" .. os.time()
local service_seq = 0

local function is_cargo(slot)
  return not (LANE == 0 and slot == LOADER_SLOT)
end

local function fuel_level()
  local level = turtle.getFuelLevel()
  if level == "unlimited" then return math.huge end
  return level
end

-- Movement ------------------------------------------------------------------
-- Turtles never attack: CC 1.63 can't tell a mob from a player, so when a
-- non-block is in the way (mob, player, falling sand) we just wait for it
-- to move.
local function wait_for_entity(warned)
  if not warned then say("Something is in my way. Waiting for it to move...", "blocked") end
  sleep(1)
  return true
end

-- Moves, digging whatever is in the way. Only used where no other turtle
-- can ever be: ahead of us in our own lane, or straight up/down.
local function dig_move(move, dig, detect)
  local failed_digs, digs, warned = 0, 0, false
  while true do
    if move() then
      if warned then say("Way is clear again.", "working") end
      return true
    end
    if turtle.getFuelLevel() == 0 then
      say("Out of fuel!", "OUT OF FUEL")
      return false
    end
    if detect() then
      if dig() then
        failed_digs = 0
        digs = digs + 1
        if digs > 50 then return false end -- endless gravel? give up
      else
        failed_digs = failed_digs + 1
        if failed_digs >= UNBREAKABLE_TRIES then return false end -- bedrock
      end
    else
      warned = wait_for_entity(warned)
    end
    sleep(0.3)
  end
end

-- Moves WITHOUT digging. Used when heading back along the surface row,
-- which is already mined and where the service turtle may be parked
-- (turtles CAN dig other turtles in CC 1.63, and turtle.inspect doesn't
-- exist until 1.64, so we can't check what's in front of us).
local function safe_move(move, detect)
  local warned = false
  while not move() do
    if turtle.getFuelLevel() == 0 then
      say("Out of fuel!", "OUT OF FUEL")
      return false
    end
    if detect() then
      if not warned then
        say("Something is blocking my way back. Waiting...", "blocked")
        warned = true
      end
      sleep(1)
    else
      warned = wait_for_entity(warned)
    end
  end
  if warned then say("Way is clear again.", "working") end
  return true
end

local function face(dir)
  if facing ~= dir then
    turtle.turnRight()
    turtle.turnRight()
    facing = dir
  end
end

local function forward()
  face(0)
  if dig_move(turtle.forward, turtle.dig, turtle.detect) then
    z = z + 1
    return true
  end
  return false
end

local function back()
  face(2)
  local moved
  if y < 0 then
    -- below the surface: the service turtle never comes down here
    moved = dig_move(turtle.forward, turtle.dig, turtle.detect)
  else
    -- surface row: already mined, and the service turtle may be parked in it
    moved = safe_move(turtle.forward, turtle.detect)
  end
  if not moved then return false end
  z = z - 1
  return true
end

local function up()
  if dig_move(turtle.up, turtle.digUp, turtle.detectUp) then
    y = y + 1
    return true
  end
  return false
end

local function down()
  if dig_move(turtle.down, turtle.digDown, turtle.detectDown) then
    y = y - 1
    return true
  end
  return false
end

local function go_to_y(target)
  while y < target do if not up() then return false end end
  while y > target do if not down() then return false end end
  return true
end

local function go_to_z(target)
  while z < target do if not forward() then return false end end
  while z > target do if not back() then return false end end
  return true
end

-- Digs the blocks above and below, staying inside the quarry (y 0..bottom).
local function clear_above_below(bottom)
  if y + 1 <= 0 then
    while turtle.detectUp() do
      if not turtle.digUp() then break end
      sleep(0.3) -- let falling gravel/sand land
    end
  end
  if y - 1 >= bottom and turtle.detectDown() then
    turtle.digDown()
  end
end

-- Inventory -----------------------------------------------------------------
local function has_cargo()
  for i = 1, 16 do
    if is_cargo(i) and turtle.getItemCount(i) > 0 then return true end
  end
  return false
end

local function inventory_full()
  for i = 1, 16 do
    if is_cargo(i) and turtle.getItemCount(i) == 0 then return false end
  end
  return true
end

-- We hand our blocks to the service turtle (instead of it sucking them
-- out of us), so it can never take lane 0's chunk loaders.
local function unload_into_service()
  face(2) -- the service turtle parks directly behind us
  for i = 1, 16 do
    if is_cargo(i) and turtle.getItemCount(i) > 0 then
      turtle.select(i)
      turtle.drop()
    end
  end
  turtle.select(1)
end

local function burn_fuel()
  for i = 1, 16 do
    if is_cargo(i) and turtle.getItemCount(i) > 0 then
      turtle.select(i)
      turtle.refuel() -- does nothing for non-fuel items
    end
  end
  turtle.select(1)
end

-- Service turtle ------------------------------------------------------------
-- Goes to this chunk's entrance, waits there while the service turtle
-- takes our blocks and hands us fuel, then returns to where we were.
local function request_service()
  local rz, ry = z, y
  -- Straight up first: the column above any spot we've visited is already
  -- mined, and so is the whole y=0 row back to the entrance.
  go_to_y(0)
  go_to_z(z_base)

  service_seq = service_seq + 1
  local req = {
    cmd = "service_request", id = LANE,
    session = session, seq = service_seq, z = z_base,
    fuel = turtle.getFuelLevel(),
  }
  print("Waiting for service turtle...")
  say(nil, "waiting for service")

  local acked = false
  local last_sent = -math.huge
  while true do
    -- re-send until acknowledged (the service turtle misses messages while
    -- moving), then only now and then in case it was restarted
    local interval = acked and 60 or 5
    if os.clock() - last_sent >= interval then
      rednet.broadcast(req, SERVICE_PROTOCOL)
      last_sent = os.clock()
    end

    local sender, msg = rednet.receive(SERVICE_PROTOCOL, 1)
    if type(msg) == "table" and msg.id == LANE
        and msg.session == session and msg.seq == req.seq then
      if msg.cmd == "ack" then
        acked = true
      elseif msg.cmd == "arrived" then
        say(nil, "unloading")
        unload_into_service()
        rednet.send(sender, {
          cmd = "unloaded", id = LANE, session = session, seq = req.seq,
        }, SERVICE_PROTOCOL)
      elseif msg.cmd == "serviced" then
        break
      end
    end
  end

  burn_fuel()
  print("Serviced. Fuel: " .. tostring(turtle.getFuelLevel()))
  say(nil, "back to work")
  go_to_z(rz)
  go_to_y(ry)
end

local function fuel_needed()
  return math.abs(y) + math.abs(z - z_base) + FUEL_BUFFER
end

local function ensure_ok()
  -- loop: one delivery might not be enough
  while fuel_level() < fuel_needed() or inventory_full() do
    request_service()
  end
end

-- Makes sure we can travel `distance` more blocks along the surface.
local function ensure_fuel_for(distance)
  while fuel_level() < distance + FUEL_BUFFER do
    request_service()
  end
end

-- Control computer ----------------------------------------------------------
-- Reports progress and asks whether to keep going. Only called while
-- parked, so the reply isn't lost. Returns false if told to stop.
local function check_in(pass)
  rednet.send(controller_id, {
    cmd = "progress", id = LANE, chunk = chunk_num, pass = pass,
    y = y, fuel = turtle.getFuelLevel(),
  }, PROTOCOL)
  local deadline = os.clock() + 2
  while os.clock() < deadline do
    local sender, msg = rednet.receive(PROTOCOL, math.max(deadline - os.clock(), 0.05))
    if sender == controller_id and type(msg) == "table" then
      if msg.cmd == "stop" then return false end
      if msg.cmd == "go" then return true end
    end
  end
  return true -- no answer: keep mining
end

-- Reports the chunk finished and waits for "next_chunk" or "stop".
local function wait_for_next_chunk()
  local last_sent = -math.huge
  while true do
    if os.clock() - last_sent >= 5 then
      rednet.send(controller_id, {
        cmd = "chunk_done", id = LANE, chunk = chunk_num, no_next_loader = no_next_loader,
      }, PROTOCOL)
      last_sent = os.clock()
    end
    local sender, msg = rednet.receive(PROTOCOL, 1)
    if sender == controller_id and type(msg) == "table" then
      if msg.cmd == "stop" then return false end
      if msg.cmd == "next_chunk" and msg.chunk == chunk_num + 1 then return true end
    end
  end
end

local function place_chunk_loader()
  if turtle.getItemCount(LOADER_SLOT) == 0 then
    say("WARNING: out of Spot Loaders (slot 15)!")
    return
  end
  turtle.select(LOADER_SLOT)
  if turtle.detectUp() then turtle.digUp() end
  if not turtle.placeUp() then
    say("WARNING: couldn't place chunk loader.")
  end
  turtle.select(1)
end

-- Lane 0 only: places the NEXT chunk's loader while still standing in the
-- current (loaded) chunk, so the next chunk is already loaded before any
-- turtle drives into it. Goes to the far end of the lane, climbs one block
-- above the surface (no turtle ever travels up there) and places the loader
-- straight ahead -- that's the first block of the next chunk, directly
-- above lane 0's next starting spot.
-- Returns false if it couldn't, in which case the run has to end here:
-- nobody may drive into a chunk that isn't loaded.
local function place_next_chunk_loader()
  if turtle.getItemCount(LOADER_SLOT) == 0 then
    say("Out of Spot Loaders (slot 15)! Ending the run after this chunk.")
    return false
  end
  go_to_z(z_base + length - 1)
  if not up() then
    say("Couldn't climb up to place the next loader. Ending the run.")
    return false
  end
  face(0)
  turtle.select(1)
  if turtle.detect() then turtle.dig() end
  turtle.select(LOADER_SLOT)
  local placed = turtle.place()
  turtle.select(1)
  go_to_y(0)
  if placed then
    say("Placed loader for chunk " .. (chunk_num + 1))
  else
    say("Couldn't place the next loader. Ending the run.")
  end
  return placed
end

-- Mining --------------------------------------------------------------------
-- Mines this lane of the current chunk in passes 3 layers thick
-- (pass 1 is centered on y=-1 and clears y = 0, -1, -2, and so on).
-- Returns false if the control computer said stop.
local function mine_chunk()
  local bottom = -(depth - 1)
  local z_end = z_base + length - 1
  local center = -1
  local pass = 1

  while true do
    local cy = math.max(center, bottom)
    if not check_in(pass) then return false end
    ensure_ok()

    if not go_to_y(cy) then return true end -- bedrock: as deep as this lane goes
    clear_above_below(bottom)

    local target = (z == z_base) and z_end or z_base
    while z ~= target do
      ensure_ok()
      local moved
      if z < target then moved = forward() else moved = back() end
      if not moved then return true end -- unbreakable block: treat as bottom
      clear_above_below(bottom)
    end

    if cy - 1 <= bottom then return true end
    center = cy - 3
    pass = pass + 1
  end
end

-- Main ----------------------------------------------------------------------
print("Lane " .. LANE .. ": waiting for the control computer...")
local registered = false
local last_hello = -math.huge
while true do
  -- re-send on a timer, NOT after every message we hear: other miners'
  -- hellos arrive here too, and answering each one floods rednet
  if os.clock() - last_hello >= 3 then
    rednet.broadcast({ cmd = "hello", id = LANE }, PROTOCOL)
    last_hello = os.clock()
  end
  local sender, msg = rednet.receive(PROTOCOL, 1)
  if type(msg) == "table" and msg.id == LANE then
    if msg.cmd == "registered" and not registered then
      registered = true
      print("Registered. Waiting for start...")
    elseif msg.cmd == "start" then
      controller_id = sender
      length = msg.length
      depth = msg.depth
      max_chunks = msg.chunks or 0
      break
    end
  end
end

print("Started: " .. length .. " long, " .. depth .. " deep.")

while true do
  ensure_ok()
  -- the first chunk's loader goes right above us; later chunks already
  -- got theirs placed ahead of time (see place_next_chunk_loader)
  if LANE == 0 and chunk_num == 1 then place_chunk_loader() end

  local keep_going = mine_chunk()

  go_to_y(0)
  local more_chunks = max_chunks == 0 or chunk_num < max_chunks
  if LANE == 0 and keep_going and more_chunks then
    ensure_fuel_for(2 * length + 4)
    no_next_loader = not place_next_chunk_loader()
  end
  go_to_z(z_base)
  face(0)

  -- Hand over everything we mined this chunk (also on the last chunk, or
  -- after a stop), so no miner finishes with a full inventory.
  if has_cargo() then request_service() end

  if not keep_going or not wait_for_next_chunk() then break end

  ensure_fuel_for(length)
  chunk_num = chunk_num + 1
  z_base = z_base + length
  -- tunnel along the surface to the next chunk; keep trying rather than
  -- carrying on with a wrong position if something blocks the way
  while not go_to_z(z_base) do
    say("Can't reach the next chunk yet, retrying...", "stuck at chunk edge")
    sleep(5)
  end
end

-- Head back to the starting row so the fleet is easy to pick up.
ensure_fuel_for(z)
go_to_y(0)
go_to_z(0)
face(0)
say("Finished, back at the start.", "finished")
