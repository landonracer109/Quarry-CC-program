-- quarry_turtle (mining turtle) -- ComputerCraft 1.63
-- Usage: m <laneId>            run as lane <laneId> (0..15)
--        m <laneId> install    also run automatically every time it boots
--        m <laneId> here       forget an interrupted run ("I'm on my start
--                              spot") -- only needed if it says it's LOST
--
-- Mines its own 1-wide lane of the current chunk, 3 layers per pass, all
-- the way down to bedrock (found by digging straight down at the start of
-- its first chunk; bedrock is flat, so the depth is kept). Each
-- pass digs forward from the chunk entrance to the far end (digging above
-- and below as it goes), then backs up to the entrance and drops 3 layers.
-- Junk (whatever is in the sample slots: cobble, dirt, gravel) goes into
-- a Trash Can it carries: placed in the mined-out space above it, filled,
-- and dug back up. When it's still nearly full, or low on fuel even after
-- burning the coal it mined, it drives home to its start spot and calls the
-- service turtle, which pulls its blocks out from behind (the service
-- turtle never leaves the home row).
--
-- SURVIVES SERVER RESTARTS: the turtle never turns, and it saves its
-- position before every move. After a restart it compares its fuel with
-- the saved value (every move costs exactly 1 fuel) to tell whether the
-- last move happened, then carries on where it left off.
--
-- SETUP (per turtle):
--   * 16 miners in a flush row, all facing the tunnel direction.
--     Lane 0 is the LEFTMOST; lane numbers increase to the RIGHT
--     (standing behind the turtles, looking the way they face).
--   * Wireless modem on every turtle.
--   * Slots 12, 13, 14: ONE cobblestone, ONE dirt, ONE gravel (samples of
--     what to throw away). Slot 15: an Extra Utilities Trash Can. Without
--     these it keeps everything (the dashboard says so).
--   * Lane 0 only: Spot Loaders in slot 16, one per chunk. It picks them
--     back up at the end of every run (finished or stopped), except chunk
--     1's loader above its start spot, which keeps the home area loaded.
--   * Run "m <lane> install" once, then reboot it (hold Ctrl+R).

local args = { ... }
local LANE = tonumber(args[1])
local OPTION = args[2]
local PROGRAM = shell and shell.getRunningProgram() or "quarry_turtle"
if not LANE then
  print("Usage: " .. PROGRAM .. " <laneId>   (lane 0..15)")
  print("       " .. PROGRAM .. " <laneId> install   (run on every boot)")
  return
end

if OPTION == "install" then
  local f = fs.open("startup", "w")
  f.write('shell.run("' .. PROGRAM .. '", "' .. LANE .. '")\n')
  f.close()
  print("Done: this turtle now runs '" .. PROGRAM .. " " .. LANE .. "' every time it boots.")
  print("Reboot (hold Ctrl+R) to start it. To undo: delete startup")
  return
end

-- Our program's checksum, so the main computer can spot a turtle running an
-- old version between runs. Only when we were started by the boot loader
-- (set up with "disk/join"), which fetches the new version when we reboot.
local MY_VERSION
if fs.exists("boot") and fs.exists(PROGRAM) then
  local h = fs.open(PROGRAM, "r")
  local text = h.readAll()
  h.close()
  local sum = 0
  for i = 1, #text do sum = (sum * 31 + text:byte(i)) % 2147483647 end
  MY_VERSION = sum
end

local STATE_FILES = { ".quarry_state_a", ".quarry_state_b" }
if OPTION == "here" then
  for _, name in ipairs(STATE_FILES) do fs.delete(name) end
  fs.delete(".quarry_away") -- left over from older versions
  print("Forgot the interrupted run. Starting fresh from this spot.")
end

local PROTOCOL = "chunkquarry"          -- control computer <-> miners
local SERVICE_PROTOCOL = "chunkservice" -- miners <-> service turtle
local STATUS_PROTOCOL = "chunkstatus"   -- status updates for the dashboard
local DEPLOY_PROTOCOL = "chunkdeploy"   -- program updates from the main computer

local function open_modem()
  for _, side in ipairs(rs.getSides()) do
    if peripheral.getType(side) == "modem" then
      rednet.open(side)
      return true
    end
  end
  return false
end

if not open_modem() then
  error("No modem attached! Attach a wireless modem and rerun.")
end

-- Prints a message and sends it (plus an optional short status) to the
-- control computer's dashboard. Fire-and-forget: broadcasting never waits,
-- and a lost update only means the display is briefly out of date.
local function say(text, state)
  if text then print(text) end
  rednet.broadcast({ cmd = "status", id = LANE, text = text, state = state }, STATUS_PROTOCOL)
end

-- IMPORTANT: a turtle throws away rednet messages that arrive while it is
-- moving, turning or digging. So every exchange below is "keep re-sending
-- until the other side answers", and we only wait for replies while parked.

-- Config --------------------------------------------------------------------
local LOADER_SLOT = 16
local FUEL_BUFFER = 20
local UNBREAKABLE_TRIES = 5 -- failed digs in a row before we call it bedrock
local MIN_FREE_SLOTS = 5    -- call the service turtle before we're completely full
local SAMPLE_SLOTS = { 12, 13, 14 } -- one each of the junk to throw away
local TRASH_SLOT = 15       -- Extra Utilities Trash Can
local LAST_FRONT_SLOT = 11  -- with a trash can, cargo the service turtle takes is in 1..11

-- Run state -------------------------------------------------------------------
-- S holds everything needed to carry on after a restart, including our
-- position (y = 0 at the start, negative below; z = blocks forward from the
-- start). It's nil when no run is in progress. It's saved to two files in
-- turn, so a restart in the middle of writing one never loses both.
local S
local save_seq = 0

local function save()
  save_seq = save_seq + 1
  S.seq = save_seq
  S.fuel = turtle.getFuelLevel()
  local f = fs.open(STATE_FILES[save_seq % 2 + 1], "w")
  f.write(textutils.serialize(S))
  f.close()
end

local function load_state()
  local best
  for _, name in ipairs(STATE_FILES) do
    if fs.exists(name) then
      local f = fs.open(name, "r")
      local text = f.readAll()
      f.close()
      local ok, t = pcall(textutils.unserialize, text)
      if ok and type(t) == "table" and type(t.seq) == "number"
          and (not best or t.seq > best.seq) then
        best = t
      end
    end
  end
  return best
end

local function clear_state()
  for _, name in ipairs(STATE_FILES) do fs.delete(name) end
  S = nil
end

-- unique per program run, so the service turtle can tell a restart apart
local session = os.getComputerID() .. ":" .. os.day() .. ":" .. os.time()
local service_seq = 0

local function is_cargo(slot)
  if S and S.trash and slot >= SAMPLE_SLOTS[1] and slot <= TRASH_SLOT then return false end
  return not (LANE == 0 and slot == LOADER_SLOT and (not S or S.loaders > 0))
end

local function fuel_level()
  local level = turtle.getFuelLevel()
  if level == "unlimited" then return math.huge end
  return level
end

-- Movement ------------------------------------------------------------------
-- We never turn: forward, back, up and down only. Every move is saved
-- BEFORE it happens, together with the fuel level; after a restart, fuel
-- one lower means the move happened, unchanged means it didn't.
local DELTA = { f = { 0, 1 }, b = { 0, -1 }, u = { 1, 0 }, d = { -1, 0 } }

local function apply_move(dir)
  S.y = S.y + DELTA[dir][1]
  S.z = S.z + DELTA[dir][2]
end

local function try_move(dir, move)
  S.pending = dir
  save()
  local ok = move()
  S.pending = nil
  if ok then apply_move(dir) end
  return ok
end

-- Turtles never attack: CC 1.63 can't tell a mob from a player, so when a
-- non-block is in the way (mob, player, falling sand) we just wait for it
-- to move.
local function wait_for_entity(warned)
  if not warned then say("Something is in my way. Waiting for it to move...", "blocked") end
  sleep(1)
  return true
end

-- Moves, digging whatever is in the way. Only used where no other turtle
-- can ever be: ahead of us in our own lane, or straight up/down.
local burn_fuel -- (defined with the inventory code below)

-- Out of fuel: burn any fuel we carry; if there's none, wait right here
-- until someone puts some in us (down in the tunnel the service turtle
-- can't reach us). Never give up: a failed move would be taken for bedrock.
local function wait_for_fuel()
  local warned = false
  while turtle.getFuelLevel() == 0 do
    burn_fuel()
    if turtle.getFuelLevel() == 0 then
      if not warned then
        say("Out of fuel! Put fuel (e.g. coal blocks) in any of my slots 1-11.",
          "OUT OF FUEL - refuel by hand")
        warned = true
      end
      sleep(10)
    end
  end
  if warned then say("Got fuel, carrying on.", "working") end
end

local function dig_move(dir, move, dig, detect)
  local failed_digs, digs, warned = 0, 0, false
  while true do
    if try_move(dir, move) then
      if warned then say("Way is clear again.", "working") end
      return true
    end
    if turtle.getFuelLevel() == 0 then
      wait_for_fuel()
    end
    if detect() then
      if dig() then
        failed_digs = 0
        digs = digs + 1
        if digs > 50 then return false end -- endless gravel? give up
      else
        failed_digs = failed_digs + 1
        if failed_digs >= UNBREAKABLE_TRIES then return false, "bedrock" end
      end
    else
      warned = wait_for_entity(warned)
    end
    sleep(0.3)
  end
end

-- Backs up WITHOUT digging (a turtle can't dig behind itself). Every row we
-- back along is already mined, so the only thing that can be in the way is
-- a mob, a player or the service turtle: wait for it to move.
local function back()
  local warned = false
  while not try_move("b", turtle.back) do
    if turtle.getFuelLevel() == 0 then
      wait_for_fuel()
    end
    if not warned then
      say("Something is behind me. Waiting for it to move...", "blocked")
      warned = true
    end
    sleep(1)
  end
  if warned then say("Way is clear again.", "working") end
  return true
end

local function forward() return dig_move("f", turtle.forward, turtle.dig, turtle.detect) end
local function up() return dig_move("u", turtle.up, turtle.digUp, turtle.detectUp) end
local function down() return dig_move("d", turtle.down, turtle.digDown, turtle.detectDown) end

local function go_to_y(target)
  while S.y < target do if not up() then return false end end
  while S.y > target do if not down() then return false end end
  return true
end

local function go_to_z(target)
  while S.z < target do if not forward() then return false end end
  while S.z > target do if not back() then return false end end
  return true
end

-- Digs the blocks above and below, staying inside the quarry (y 0..bottom).
local function clear_above_below(bottom)
  if S.y + 1 <= 0 then
    while turtle.detectUp() do
      if not turtle.digUp() then break end
      sleep(0.3) -- let falling gravel/sand land
    end
  end
  if S.y - 1 >= bottom and turtle.detectDown() then
    turtle.digDown()
  end
end

-- Inventory -----------------------------------------------------------------
local function used_cargo_slots()
  local n = 0
  for i = 1, 16 do
    if is_cargo(i) and turtle.getItemCount(i) > 0 then n = n + 1 end
  end
  return n
end

local function has_cargo() return used_cargo_slots() > 0 end

-- How many stacks the service turtle should pull. It takes from our first
-- non-empty slot each time, so with samples in 12-14 it may only take
-- cargo from slots 1..11 (slot 16 is moved down afterwards).
local function stacks_for_service()
  local last = S.trash and LAST_FRONT_SLOT or 16
  local n = 0
  for i = 1, last do
    if is_cargo(i) and turtle.getItemCount(i) > 0 then n = n + 1 end
  end
  return n
end

local function tidy_slot_16()
  if not (S.trash and is_cargo(16) and turtle.getItemCount(16) > 0) then return end
  for i = 1, LAST_FRONT_SLOT do
    if turtle.getItemCount(i) == 0 then
      turtle.select(16)
      turtle.transferTo(i)
      break
    end
  end
  turtle.select(1)
end

-- We call the service turtle while a few slots are still free: it carries
-- 12 stacks, so this way one visit can take everything we have.
local function inventory_nearly_full()
  local cargo_slots = 0
  for i = 1, 16 do if is_cargo(i) then cargo_slots = cargo_slots + 1 end end
  return cargo_slots - used_cargo_slots() < MIN_FREE_SLOTS
end

-- How much fuel we can hold (advanced turtles 100000, others 20000).
local function fuel_limit()
  local limit = turtle.getFuelLimit and turtle.getFuelLimit() or 20000
  if type(limit) ~= "number" then return math.huge end
  return limit
end

-- Burns fuel from our cargo (handed over, or coal we mined), but only as
-- much as fits in the tank: the rest stays as cargo.
function burn_fuel()
  for i = 1, 16 do
    if fuel_level() >= fuel_limit() then break end
    if is_cargo(i) and turtle.getItemCount(i) > 0 then
      turtle.select(i)
      local before = fuel_level()
      if turtle.refuel(1) then -- fails for anything that isn't fuel
        local per_item = fuel_level() - before
        if per_item > 0 then
          local fit = math.floor((fuel_limit() - fuel_level()) / per_item)
          local n = math.min(fit, turtle.getItemCount(i))
          if n > 0 then turtle.refuel(n) end
        end
      end
    end
  end
  turtle.select(1)
  save() -- fuel changed: the saved fuel level must match again
end

-- Trash can -------------------------------------------------------------------
local DIRS = {
  u = { place = turtle.placeUp, drop = turtle.dropUp, dig = turtle.digUp, detect = turtle.detectUp },
  d = { place = turtle.placeDown, drop = turtle.dropDown, dig = turtle.digDown, detect = turtle.detectDown },
}

-- Digs the trash can back up. Also used after a restart: S.trash_out says
-- it may still be out there.
local function pick_up_trash()
  local d = DIRS[S.trash_out]
  turtle.select(TRASH_SLOT)
  if turtle.getItemCount(TRASH_SLOT) == 0 and d.detect() then d.dig() end
  turtle.select(1)
  if turtle.getItemCount(TRASH_SLOT) == 0 then
    say("Couldn't pick my trash can back up! Keeping everything from now on.", "no trash can")
    S.trash = false
  end
  S.trash_out = nil
  save()
end

local function is_junk(slot)
  turtle.select(slot)
  for _, s in ipairs(SAMPLE_SLOTS) do
    if turtle.compareTo(s) then return true end
  end
  return false
end

-- Throws away everything that matches a sample (keeping one of each).
-- The trash can goes in the mined-out space above us (below when we're on
-- the top layer), and comes straight back.
local function dump_junk()
  if not S.trash then return end
  local junk = {}
  for i = 1, 16 do
    if is_cargo(i) and turtle.getItemCount(i) > 0 and is_junk(i) then
      table.insert(junk, i)
    end
  end
  local extra = 0
  for _, s in ipairs(SAMPLE_SLOTS) do extra = extra + turtle.getItemCount(s) - 1 end
  turtle.select(1)
  if #junk == 0 and extra < 64 then return end

  local dir = S.y <= -1 and "u" or "d"
  local d = DIRS[dir]
  if d.detect() then d.dig() end -- gravel may have fallen in
  S.trash_out = dir
  save()
  turtle.select(TRASH_SLOT)
  if not d.place() then
    -- something in the way (a mob?): try again next time
    turtle.select(1)
    S.trash_out = nil
    save()
    return
  end
  say(nil, "throwing out junk")
  for _, s in ipairs(SAMPLE_SLOTS) do
    local n = turtle.getItemCount(s) - 1
    if n > 0 then
      turtle.select(s)
      d.drop(n)
    end
  end
  for _, i in ipairs(junk) do
    turtle.select(i)
    d.drop()
  end
  pick_up_trash()
  say(nil, "working")
end

-- Service turtle ------------------------------------------------------------
-- Drives home to our start spot and waits there while the service turtle
-- (on the home row right behind us) pulls out our blocks and hands us
-- fuel, then returns to where we were.
local function request_service()
  local rz, ry = S.z, S.y
  -- Straight up first: the column above any spot we've visited is already
  -- mined, and so is the whole y=0 row back home.
  while not (S.y == 0 and S.z == 0) do
    go_to_y(0)
    go_to_z(0)
    if not (S.y == 0 and S.z == 0) then sleep(5) end
  end
  dump_junk() -- no point carrying junk to the service turtle

  -- enough to get back to work, work a row, and come home again
  local need = 2 * (math.abs(ry) + rz) + S.length + FUEL_BUFFER
  while true do
  service_seq = service_seq + 1
  local req = {
    cmd = "service_request", id = LANE,
    session = session, seq = service_seq, z = 0,
    fuel = turtle.getFuelLevel(), limit = fuel_limit(), stacks = stacks_for_service(),
  }
  print("Waiting for service turtle...")
  say(nil, "waiting for service")

  local acked = false
  local last_sent = -math.huge
  while true do
    -- re-send until acknowledged (the service turtle misses messages while
    -- moving), then only now and then in case it was restarted
    local interval = acked and 60 or 5
    if os.clock() - last_sent >= interval then
      rednet.broadcast(req, SERVICE_PROTOCOL)
      last_sent = os.clock()
    end

    local sender, msg = rednet.receive(SERVICE_PROTOCOL, 1)
    if type(msg) == "table" and msg.id == LANE
        and msg.session == session and msg.seq == req.seq then
      if msg.cmd == "ack" then
        acked = true
      elseif msg.cmd == "arrived" then
        -- it pulls exactly this many stacks, so it never reaches the
        -- chunk loaders in slot 16 (lane 0)
        say(nil, "unloading")
        rednet.send(sender, {
          cmd = "ready", id = LANE, session = session, seq = req.seq,
          stacks = stacks_for_service(),
        }, SERVICE_PROTOCOL)
      elseif msg.cmd == "serviced" then
        break
      end
    end
  end

  burn_fuel()
  tidy_slot_16()
  print("Serviced. Fuel: " .. tostring(turtle.getFuelLevel()))
  -- never drive back down on an empty "serviced": wait here and ask again
  if fuel_level() >= need and not inventory_nearly_full() then break end
  say("Still not enough fuel to get back to work: waiting at home.", "waiting for fuel")
  sleep(10)
  end -- while
  say(nil, "back to work")
  go_to_z(rz)
  go_to_y(ry)
end

-- enough to finish this row and still get home
local function fuel_needed()
  return math.abs(S.y) + S.z + S.length + FUEL_BUFFER
end

local function ensure_ok()
  if inventory_nearly_full() then dump_junk() end
  if fuel_level() < fuel_needed() then burn_fuel() end -- coal we mined
  -- loop: one delivery might not be enough
  while fuel_level() < fuel_needed() or inventory_nearly_full() do
    request_service()
  end
end

-- Makes sure we can travel `distance` more blocks along the surface.
local function ensure_fuel_for(distance)
  while fuel_level() < distance + FUEL_BUFFER do
    request_service()
  end
end

-- Control computer ----------------------------------------------------------
-- Reports progress and asks whether to keep going. Only called while
-- parked, so the reply isn't lost. Returns false if told to stop.
local function check_in()
  rednet.send(S.controller, {
    cmd = "progress", id = LANE, chunk = S.chunk, pass = S.pass,
    y = S.y, fuel = turtle.getFuelLevel(), depth = S.depth,
  }, PROTOCOL)
  local deadline = os.clock() + 2
  while os.clock() < deadline do
    local sender, msg = rednet.receive(PROTOCOL, math.max(deadline - os.clock(), 0.05))
    if sender == S.controller and type(msg) == "table" then
      if msg.cmd == "stop" then return false end
      if msg.cmd == "go" then return true end
    end
  end
  return true -- no answer: keep mining
end

-- Reports the chunk finished and waits for "next_chunk" or "stop".
local function wait_for_next_chunk()
  local last_sent = -math.huge
  while true do
    if os.clock() - last_sent >= 5 then
      rednet.send(S.controller, {
        cmd = "chunk_done", id = LANE, chunk = S.chunk, no_next_loader = S.no_next_loader,
      }, PROTOCOL)
      last_sent = os.clock()
    end
    local sender, msg = rednet.receive(PROTOCOL, 1)
    if sender == S.controller and type(msg) == "table" then
      if msg.cmd == "stop" then return false end
      if msg.cmd == "next_chunk" and msg.chunk == S.chunk + 1 then return true end
    end
  end
end

-- Chunk loaders (lane 0) --------------------------------------------------------
-- Placing is safe to repeat after a restart: whatever is already in the
-- spot (maybe the loader we just placed) is dug out first, then placed again.
local function loaders_left()
  if turtle.getItemCount(LOADER_SLOT) == 0 then S.loaders = 0 end
  return S.loaders > 0
end

-- Chunk 1's loader goes right above the start spot, and stays there
-- between runs: if it's already in place, keep it.
local function place_first_loader()
  if turtle.getItemCount(LOADER_SLOT) > 0 then
    turtle.select(LOADER_SLOT)
    local already = turtle.compareUp()
    turtle.select(1)
    if already then
      S.loader_top = math.max(S.loader_top or 0, 1)
      return
    end
  end
  if not loaders_left() then
    say("WARNING: no Spot Loaders in slot 16!")
    return
  end
  if turtle.detectUp() then turtle.digUp() end
  turtle.select(LOADER_SLOT)
  if turtle.placeUp() then
    S.loaders = S.loaders - 1
    S.loader_top = math.max(S.loader_top or 0, 1)
  else
    say("WARNING: couldn't place chunk loader.")
  end
  turtle.select(1)
end

-- Places the NEXT chunk's loader while still standing in the current
-- (loaded) chunk, so the next chunk is loaded before anyone drives into it:
-- at the far end of the lane, one block above the surface (no turtle ever
-- travels up there), straight ahead -- the first block of the next chunk,
-- directly above lane 0's next starting spot. Returns false if it couldn't,
-- in which case the run has to end after this chunk.
local function place_next_chunk_loader()
  if not loaders_left() then
    say("Out of Spot Loaders (slot 16)! Ending the run after this chunk.")
    return false
  end
  if S.y < 1 then
    go_to_z(S.z_base + S.length - 1)
    if not up() then
      say("Couldn't climb up to place the next loader. Ending the run.")
      return false
    end
  end
  turtle.select(1)
  if turtle.detect() then turtle.dig() end
  turtle.select(LOADER_SLOT)
  local placed = turtle.place()
  turtle.select(1)
  if placed then
    S.loaders = S.loaders - 1
    S.loader_top = S.chunk + 1 -- highest chunk with a loader in it
  end
  save()
  go_to_y(0)
  if placed then
    say("Placed loader for chunk " .. (S.chunk + 1))
  else
    say("Couldn't place the next loader. Ending the run.")
  end
  return placed
end

-- At the end of a run lane 0 is the last one out and takes the loaders back
-- (into slot 16) on its way home. First the control computer must confirm
-- that every other lane and the service turtle are back: a chunk whose
-- loader we take is unloaded, and a turtle still in it would be frozen.
local function wait_to_collect()
  say("Waiting for everyone else to get home, then picking up the loaders.",
    "waiting to collect loaders")
  local last_sent = -math.huge
  while true do
    if os.clock() - last_sent >= 5 then
      rednet.send(S.controller, { cmd = "may_collect", id = LANE }, PROTOCOL)
      last_sent = os.clock()
    end
    local sender, msg = rednet.receive(PROTOCOL, 1)
    if sender == S.controller and type(msg) == "table"
        and msg.cmd == "collect" and msg.id == LANE then
      return
    end
  end
end

-- Backs out of the tunnel picking up each chunk's loader from the chunk
-- before it (still loaded by its own loader): at the far end of that chunk,
-- one up, dig forward -- the spot it was placed from. Safe to restart: a
-- spot that's already empty is just skipped. Chunk 1's loader (above our
-- start spot) stays, so the home chunk stays loaded between runs.
local function collect_loaders()
  if not S.collect_ok then
    wait_to_collect()
    S.collect_ok = true
    save()
    say("Picking up the chunk loaders.", "collecting loaders")
  end
  -- make room in slot 16 if blocks ended up there after the loaders ran out
  if turtle.getItemCount(LOADER_SLOT) > 0 and S.loaders == 0 then
    for i = 1, 15 do
      if turtle.getItemCount(i) == 0 then
        turtle.select(LOADER_SLOT)
        turtle.transferTo(i)
        break
      end
    end
  end
  while (S.loader_top or 0) >= 2 do
    local j = S.loader_top
    go_to_y(0)
    go_to_z(S.length * (j - 1) - 1)
    go_to_y(1)
    if turtle.detect() then
      turtle.select(LOADER_SLOT)
      turtle.dig()
    end
    turtle.select(1)
    S.loaders = turtle.getItemCount(LOADER_SLOT)
    S.loader_top = j - 1
    save()
  end
  go_to_y(0)
end

-- Mining --------------------------------------------------------------------
-- Digs straight down from the chunk entrance until bedrock, and remembers
-- how deep that is (bedrock is flat, so it's the same for every chunk).
-- Every pass goes down this column anyway. Safe to restart: it just keeps
-- going down from wherever we are.
local function find_bedrock()
  say("Digging down to find bedrock...", "finding bedrock")
  go_to_z(S.z_base)
  while true do
    ensure_ok()
    local ok, why = down()
    if not ok and why == "bedrock" then break end
    if not ok then sleep(1) end
  end
  -- we're on the lowest layer that can be mined
  S.depth = 1 - S.y
  save()
  say("Bedrock is " .. (S.depth + 1) .. " blocks down.", "working")
end

local function passes_per_chunk() return math.ceil(S.depth / 3) end

-- Pass p is centered on y = -1 - 3(p-1) and clears that layer plus the ones
-- above and below it. The last one is raised so it stays inside the depth.
local function pass_center(p)
  return math.max(-1 - 3 * (p - 1), -(S.depth - 1))
end

-- One pass: down to the pass's layer at the chunk entrance, forward to the
-- far end, then back to the entrance. Safe to restart from any point.
-- Returns false if we hit something unbreakable (bedrock).
local function do_pass(p)
  local bottom = -(S.depth - 1)
  local cy = pass_center(p)
  local z_end = S.z_base + S.length - 1
  if S.y ~= cy then
    go_to_z(S.z_base) -- back along an already-mined layer
    if not go_to_y(cy) then return false end
  end
  clear_above_below(bottom)
  while S.z < z_end do
    ensure_ok()
    if not forward() then return false end
    clear_above_below(bottom)
  end
  go_to_z(S.z_base)
  return true
end

-- Mines the rest of the current chunk. Returns false if told to stop.
local function mine_chunk()
  if not S.depth then find_bedrock() end
  while S.pass <= passes_per_chunk() do
    if not check_in() then return false end
    ensure_ok()
    local ok = do_pass(S.pass)
    S.pass = ok and S.pass + 1 or passes_per_chunk() + 1 -- bedrock: chunk done
    save()
  end
  return true
end

-- Main ----------------------------------------------------------------------
-- The run is a series of phases, saved in S.phase, so after a restart we
-- pick up in the right one:
--   mining      mining passes S.pass.. of chunk S.chunk
--   loader      lane 0 places the next chunk's loader
--   chunk_end   hand over our blocks, report the chunk done, wait
--   transit     drive along the surface to the next chunk's entrance
--   going_home  back to the start spot at the end of the run
local function run()
  while true do
    if S.phase == "mining" then
      if LANE == 0 and not S.first_loader_done then
        place_first_loader()
        S.first_loader_done = true
        save()
      end
      local keep_going = true
      if S.chunk <= (S.skip or 0) then
        -- mined in an earlier run: just pass through (lane 0 still places
        -- the loaders, so every chunk we drive through is loaded)
        say("Passing chunk " .. S.chunk .. " (mined in an earlier run).", "passing chunk " .. S.chunk)
      else
        keep_going = mine_chunk()
      end
      go_to_y(0)
      S.stopped = not keep_going
      local more_chunks = S.max_chunks == 0 or S.chunk < S.max_chunks
      S.phase = (LANE == 0 and keep_going and more_chunks) and "loader" or "chunk_end"
      save()

    elseif S.phase == "loader" then
      ensure_fuel_for(2 * S.length + 4)
      S.no_next_loader = not place_next_chunk_loader()
      S.phase = "chunk_end"
      save()

    elseif S.phase == "chunk_end" then
      -- (lane 0 waits at the far end, where it placed the next loader)
      go_to_y(0)
      if S.stopped or not wait_for_next_chunk() then
        S.phase = "going_home"
      else
        ensure_fuel_for(S.length)
        S.chunk = S.chunk + 1
        S.z_base = S.z_base + S.length
        S.pass = 1
        S.phase = "transit"
      end
      save()

    elseif S.phase == "transit" then
      -- keep trying rather than carrying on from the wrong spot
      while not go_to_z(S.z_base) do
        say("Can't reach the next chunk yet, retrying...", "stuck at chunk edge")
        sleep(5)
      end
      S.phase = "mining"
      save()

    elseif S.phase == "going_home" then
      local collecting = LANE == 0 and (S.loader_top or 0) >= 2
      if collecting then
        -- may drive to the far end of this chunk, plus up/down per loader
        ensure_fuel_for(S.z + S.length + 2 * S.loader_top + 2)
        go_to_y(0)
        collect_loaders()
      else
        ensure_fuel_for(S.z)
      end
      go_to_y(0)
      go_to_z(0)
      if S.y == 0 and S.z == 0 then
        -- hand everything over before we call it a day
        dump_junk()
        if has_cargo() then request_service() end
        clear_state()
        say("Finished, back at the start.", "finished")
      else
        say("Finished, but couldn't get all the way back to my start spot!", "LOST - move to start")
      end
      return
    end
  end
end

-- Waits for the control computer's "start" and sets up a fresh run. This
-- is also the only time we accept "reboot to update" from the main
-- computer: never in the middle of a run.
local function register_and_wait()
  print("Lane " .. LANE .. ": waiting for the control computer...")
  local registered = false
  local last_hello = -math.huge
  while true do
    -- re-send on a timer, NOT after every message we hear: other miners'
    -- hellos arrive here too, and answering each one floods rednet
    if os.clock() - last_hello >= 3 then
      rednet.broadcast({ cmd = "hello", id = LANE, version = MY_VERSION }, PROTOCOL)
      last_hello = os.clock()
    end
    local sender, msg, protocol = rednet.receive(nil, 1)
    if protocol == DEPLOY_PROTOCOL and type(msg) == "table" and msg.cmd == "update_reboot" then
      say("Rebooting to install an update.", "updating")
      os.reboot()
    end
    if protocol == PROTOCOL and type(msg) == "table" and msg.id == LANE then
      if msg.cmd == "registered" and not registered then
        registered = true
        print("Registered. Waiting for start...")
      elseif msg.cmd == "start" then
        return sender, msg
      end
    end
  end
end

local function lost(reason)
  say(reason, "LOST - move to start")
  print("Put me back on my start spot, facing the tunnel, then run:")
  print("  " .. PROGRAM .. " " .. LANE .. " here")
end

-- Starts a run: either resumes the one saved on disk (after a restart) or
-- waits for the control computer to start a new one. Returns false if we
-- can't carry on (LOST).
local function start_run()
  S = load_state()
  if not S then
    local controller, msg = register_and_wait()
    -- samples in 12-14 and a trash can in 15: throw junk away
    local trash = true
    for i = SAMPLE_SLOTS[1], TRASH_SLOT do
      if turtle.getItemCount(i) == 0 then trash = false end
    end
    if not trash then
      say("No trash can (slot 15) or samples (slots 12-14): keeping everything.")
    end
    local chunk = msg.chunk or 1
    S = {
      -- depth: layers down to bedrock, found when we first dig down
      controller = controller, length = msg.length, depth = nil, trash = trash,
      max_chunks = msg.chunks or 0, chunk = chunk, skip = msg.skip or 0,
      z_base = (chunk - 1) * msg.length, pass = 1, y = 0, z = 0,
      loaders = (LANE == 0) and turtle.getItemCount(LOADER_SLOT) or 0,
      -- joining a run already past chunk 1: that chunk's loader is placed
      first_loader_done = chunk > 1,
      loader_top = (chunk > 1) and chunk or nil,
    }
    S.phase = (S.z_base > 0) and "transit" or "mining"
    save_seq = 0
    save()
    print("Started: " .. S.length .. " long, down to bedrock.")
    return true
  end

  save_seq = S.seq
  -- Did the last move before the restart happen? Every move costs 1 fuel.
  if S.pending then
    local now_fuel = turtle.getFuelLevel()
    if type(now_fuel) ~= "number" or type(S.fuel) ~= "number" then
      lost("Restarted mid-move with unlimited fuel, so I can't tell where I am.")
      return false
    elseif now_fuel == S.fuel - 1 then
      apply_move(S.pending)
    elseif S.fuel == 0 then
      -- we had no fuel, so that move can't have happened (someone has
      -- given us fuel by hand since)
    elseif now_fuel ~= S.fuel then
      lost("Restarted and my fuel doesn't match my notes, so I can't tell where I am.")
      return false
    end
    S.pending = nil
  end
  save()
  if S.trash_out then pick_up_trash() end
  say("Restarted: resuming chunk " .. S.chunk .. " (" .. S.phase .. ").", "resuming")
  return true
end

-- Run after run: when one ends with us back on the start spot, wait for
-- the next START. Stop only if we're LOST.
while start_run() do
  run()
  if S then return end -- ended away from the start spot: LOST
end
