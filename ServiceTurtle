-- quarry_service (service turtle) -- ComputerCraft 1.63
-- Run on ONE dedicated turtle. It shuttles between the mining turtles,
-- taking their mined blocks and handing them fuel, so the miners never
-- need their own chests.
--
-- SETUP (stand behind the miners, looking the way they face):
--   * HOME spot: one block BEHIND lane 0's start and one block to its LEFT.
--     Place the service turtle there, facing the same way as the miners.
--   * OUTPUT chest directly BEHIND the home spot (mined blocks go here).
--   * FUEL chest directly BELOW the home spot. Put ONLY fuel in it, and
--     only one kind (e.g. all coal).
--   * Clear the row the service turtle drives along (home spot + the 16
--     blocks to its right) -- it will dig that row if needed, but never
--     digs inside the lanes, so it can't destroy a mining turtle.
--   * Wireless modem.
--   * Run: s   (leave it running; Ctrl+T to stop when done)
--          s install   also run automatically every time it boots
--          s here      "I'm back on my home spot" after a reboot away from home
--   * Home must stay chunk-loaded (control computer + both chests).
--
-- INVENTORY: slots 1-12 = mined blocks, slots 13-16 = coal for the miners
-- (filled automatically from the fuel chest). It only goes home when it
-- has no room for the next load, runs low on coal, or has been idle for
-- 30 seconds.

local SERVICE_PROTOCOL = "chunkservice" -- miners <-> service turtle

local OPTION = ({ ... })[1]
local PROGRAM = shell and shell.getRunningProgram() or "quarry_service"
if OPTION == "install" then
  local f = fs.open("startup", "w")
  f.write('shell.run("' .. PROGRAM .. '")\n')
  f.close()
  print("Done: this turtle now runs '" .. PROGRAM .. "' every time it boots.")
  print("Reboot (hold Ctrl+R) to start it. To undo: delete startup")
  return
end

-- This file exists whenever we're away from the home spot. Our position is
-- only kept in memory, so if we boot up and find it, we were interrupted
-- (server restart, chunk unloaded, reboot) and don't know where we are.
local AWAY_FILE = ".quarry_away"
if OPTION == "here" then fs.delete(AWAY_FILE) end

local function open_modem()
  for _, side in ipairs(rs.getSides()) do
    if peripheral.getType(side) == "modem" then
      rednet.open(side)
      return true
    end
  end
  return false
end

if not open_modem() then
  error("No modem attached! Attach a wireless modem and rerun.")
end

-- Config --------------------------------------------------------------------
-- Inventory: slots 1-12 carry mined blocks, slots 13-16 carry coal for the
-- miners (4 stacks = 256 coal = 16 deliveries between trips home).
local CARGO_SLOTS = 12
local FIRST_FUEL_SLOT = 13
local FUEL_BATCH = 16       -- fuel items handed to a miner per visit (16 coal = 1280 moves)
local MINER_FUEL_TARGET = 1500 -- only hand over fuel if the miner has less than this
local SELF_FUEL_TARGET = 2000
local LOW_STOCK = FUEL_BATCH * 4 -- when idle, go home to refill below this
local IDLE_HOME_AFTER = 30  -- seconds with nothing to do before going home
local HANDSHAKE_TIMEOUT = 60
local UNBREAKABLE_TRIES = 5

local function fuel_stock()
  local n = 0
  for slot = FIRST_FUEL_SLOT, 16 do n = n + turtle.getItemCount(slot) end
  return n
end

-- Dashboard -----------------------------------------------------------------
-- Status updates for the control computer's display. Fire-and-forget:
-- broadcasting never waits, and a lost update only means a stale display.
local STATUS_PROTOCOL = "chunkstatus"
local queue = {}   -- FIFO of service jobs (see Requests below)
local status = { state = "starting up", lane = false }
local last_report = 0

-- Prints `text` (if given) and sends our current state to the dashboard.
-- `lane` is the lane we're busy with, or false for none (nil = unchanged).
local function report(state, text, lane)
  if state then status.state = state end
  if lane ~= nil then status.lane = lane end
  if text then print(text) end
  rednet.broadcast({
    cmd = "service", state = status.state, lane = status.lane, text = text,
    queue = #queue, fuel = turtle.getFuelLevel(),
    stock = fuel_stock(),
  }, STATUS_PROTOCOL)
  last_report = os.clock()
end

if fs.exists(AWAY_FILE) then
  report("LOST - move home", "I was restarted away from my home spot and don't know where I am.")
  print("Put me back on my home spot (above the fuel chest, facing")
  print("the same way as the miners), then run:")
  print("  " .. PROGRAM .. " here")
  return
end

-- sx = blocks to the right of home (along the row of lanes)
-- sz = blocks forward from home (into the tunnels)
local sx, sz, facing = 0, 0, 0 -- facing: 0 = tunnel dir, 1 = right, 2 = back, 3 = left

-- Keeps AWAY_FILE in step with whether we're on the home spot facing forward.
-- It's written BEFORE any turn or step (so a restart mid-move still counts
-- as lost) and only removed once we're back home facing forward.
local away = false
local function write_away(now_away)
  if now_away == away then return end
  away = now_away
  if away then
    local f = fs.open(AWAY_FILE, "w")
    f.write("service turtle is away from its home spot\n")
    f.close()
  else
    fs.delete(AWAY_FILE)
  end
end
local function update_away()
  write_away(sx ~= 0 or sz ~= 0 or facing ~= 0)
end

local function fuel_level()
  local level = turtle.getFuelLevel()
  if level == "unlimited" then return math.huge end
  return level
end

-- Movement ------------------------------------------------------------------
local function face(dir)
  local diff = (dir - facing) % 4
  if diff ~= 0 then write_away(true) end
  if diff == 1 then
    turtle.turnRight()
  elseif diff == 2 then
    turtle.turnRight()
    turtle.turnRight()
  elseif diff == 3 then
    turtle.turnLeft()
  end
  facing = dir
  update_away()
end

local function track_step()
  if facing == 0 then sz = sz + 1
  elseif facing == 1 then sx = sx + 1
  elseif facing == 2 then sz = sz - 1
  else sx = sx - 1 end
  update_away()
end

-- One step forward. Digs only when allow_dig is true (the home row, where
-- no mining turtle ever goes). Inside lanes it waits instead, because the
-- only solid thing there could be a turtle -- and turtles CAN dig turtles.
-- Never attacks: CC 1.63 can't tell a mob from a player, so it waits for
-- anything that isn't a block to move out of the way.
local function forward(allow_dig)
  local failed_digs = 0
  local waited = 0
  local warned_entity = false
  write_away(true)
  while not turtle.forward() do
    if turtle.getFuelLevel() == 0 then
      report("OUT OF FUEL", "Out of fuel!")
      return false
    end
    if turtle.detect() then
      if allow_dig then
        if turtle.dig() then
          failed_digs = 0
        else
          failed_digs = failed_digs + 1
          if failed_digs >= UNBREAKABLE_TRIES then return false end
        end
      else
        waited = waited + 1
        if waited == 1 then report("blocked in a lane", "Blocked inside a lane, waiting...") end
        if waited >= 30 then return false end
        sleep(1)
      end
    else
      if not warned_entity then
        report("blocked", "Something is in my way. Waiting for it to move...")
        warned_entity = true
      end
      sleep(1)
    end
    sleep(0.3)
  end
  track_step()
  return true
end

-- Along the home row (sz = 0), digging allowed.
local function go_to_x(target)
  if sx == target then return true end
  face(sx < target and 1 or 3)
  while sx ~= target do
    if not forward(true) then return false end
  end
  return true
end

-- Inside a lane's already-mined tunnel, never digs.
local function go_to_z(target)
  if sz == target then return true end
  face(sz < target and 0 or 2)
  while sz ~= target do
    if not forward(false) then return false end
  end
  return true
end

-- Lane changes only happen on the home row (sz = 0), one block behind the
-- miners' start line; depth moves only happen inside a lane's own tunnel.
local function go_to(x, z)
  return go_to_z(0) and go_to_x(x) and go_to_z(z)
end

-- Inventory -----------------------------------------------------------------
local function free_cargo_slots()
  local n = 0
  for i = 1, CARGO_SLOTS do
    if turtle.getItemCount(i) == 0 then n = n + 1 end
  end
  return n
end

local function cargo_empty()
  return free_cargo_slots() == CARGO_SLOTS
end

-- Fills the fuel slots (13-16) from the fuel chest below.
local function top_up_fuel()
  for slot = FIRST_FUEL_SLOT, 16 do
    turtle.select(slot)
    while turtle.getItemCount(slot) < 64 do
      local before = turtle.getItemCount(slot)
      if not turtle.suckDown() then break end
      -- anything that spilled into the cargo slots goes back in the chest
      for i = 1, CARGO_SLOTS do
        if turtle.getItemCount(i) > 0 then
          turtle.select(i)
          turtle.dropDown()
        end
      end
      turtle.select(slot)
      if turtle.getItemCount(slot) == before then break end
    end
  end
  turtle.select(1)
end

-- Burns ONE fuel item from the stock (never a whole stack, so there's
-- always some left to deliver).
local function burn_one_fuel()
  for slot = 16, FIRST_FUEL_SLOT, -1 do
    if turtle.getItemCount(slot) > 0 then
      turtle.select(slot)
      local ok = turtle.refuel(1)
      turtle.select(1)
      return ok
    end
  end
  return false
end

-- Hands `count` fuel items to the turtle in front of us.
local function hand_over_fuel(count)
  for slot = 16, FIRST_FUEL_SLOT, -1 do
    if count <= 0 then break end
    local n = math.min(count, turtle.getItemCount(slot))
    if n > 0 then
      turtle.select(slot)
      if turtle.drop(n) then count = count - n end
    end
  end
  turtle.select(1)
end

-- Goes home, empties cargo into the output chest, refuels itself and
-- refills the coal stock.
local function restock()
  report("restocking at home", nil, false)
  while not go_to(0, 0) do
    report("can't get home", "Can't get home -- something is in the way. Retrying...")
    sleep(5)
  end

  face(2)
  while not cargo_empty() do
    for i = 1, CARGO_SLOTS do
      if turtle.getItemCount(i) > 0 then
        turtle.select(i)
        turtle.drop()
      end
    end
    if not cargo_empty() then
      report("OUTPUT CHEST FULL", "Output chest is full! Empty it...")
      sleep(10)
    end
  end

  top_up_fuel()
  while fuel_level() < SELF_FUEL_TARGET and fuel_stock() > FUEL_BATCH do
    if not burn_one_fuel() then
      report("BAD FUEL", "The coal slots (13-16) hold something that isn't fuel! Only put fuel in the fuel chest.")
      break
    end
  end
  top_up_fuel()

  while fuel_stock() == 0 do
    report("FUEL CHEST EMPTY", "Fuel chest is empty! Add fuel...")
    sleep(10)
    top_up_fuel()
  end

  turtle.select(1)
  face(0)
end

-- Requests ------------------------------------------------------------------
-- (queue is declared with the dashboard code above)
local queued = {}  -- [lane] = request key while waiting in the queue
local served = {}  -- [lane] = key of the last request we completed
local current_key  -- key of the job in progress

local function request_key(msg)
  return tostring(msg.session) .. "#" .. tostring(msg.seq)
end

local function reply(to, cmd, job)
  rednet.send(to, {
    cmd = cmd, id = job.id, session = job.session, seq = job.seq,
  }, SERVICE_PROTOCOL)
end

-- Handles a request whenever one arrives, even in the middle of another
-- job, so requests aren't lost while we're busy.
local function handle_message(sender, msg)
  if type(msg) ~= "table" or msg.cmd ~= "service_request"
      or type(msg.id) ~= "number" then
    return
  end
  local key = request_key(msg)
  if served[msg.id] == key then
    reply(sender, "serviced", msg) -- already done; it just missed our reply
    return
  end
  if queued[msg.id] ~= key and current_key ~= key then
    queued[msg.id] = key
    table.insert(queue, {
      id = msg.id, session = msg.session, seq = msg.seq,
      z = msg.z, fuel = msg.fuel, stacks = msg.stacks, sender = sender, key = key,
    })
    print("Queued lane " .. msg.id)
    report()
  end
  reply(sender, "ack", msg)
end

local function serve(job)
  local trip = 2 * (job.id + 1 + job.z) + 20
  -- ("unlimited" fuel comes through as a string: no delivery needed)
  local needs_fuel = type(job.fuel) == "number" and job.fuel < MINER_FUEL_TARGET
  -- the miner tells us how many slots of blocks it will hand over
  local space_needed = math.min(job.stacks or CARGO_SLOTS, CARGO_SLOTS)
  -- only go home when we must: no room for this load, not enough coal
  -- to hand over, or not enough fuel for the trip ourselves
  if free_cargo_slots() < space_needed
      or (needs_fuel and fuel_stock() < FUEL_BATCH)
      or fuel_level() < trip then
    restock()
  end

  report("going to lane " .. job.id, "Servicing lane " .. job.id, job.id)
  -- lane N is N+1 blocks right of home; parking at sz = job.z puts us
  -- directly behind a miner waiting at its chunk entrance
  if not go_to(job.id + 1, job.z) then
    report("path blocked", "Path to lane " .. job.id .. " blocked, will retry.")
    return false
  end
  face(0)

  -- Tell the miner we're here and wait for it to drop its blocks into us.
  report("unloading lane " .. job.id)
  local start = os.clock()
  local last_sent = -math.huge
  while true do
    if os.clock() - start > HANDSHAKE_TIMEOUT then
      report(nil, "Lane " .. job.id .. " never answered, skipping.")
      return false
    end
    if os.clock() - last_sent >= 3 then
      reply(job.sender, "arrived", job)
      last_sent = os.clock()
    end
    local sender, msg = rednet.receive(SERVICE_PROTOCOL, 1)
    if type(msg) == "table" and msg.cmd == "unloaded" and msg.id == job.id
        and msg.session == job.session and msg.seq == job.seq then
      break
    end
    handle_message(sender, msg)
  end

  if needs_fuel then hand_over_fuel(FUEL_BATCH) end

  served[job.id] = job.key
  reply(job.sender, "serviced", job)
  return true
end

-- Main ----------------------------------------------------------------------
report("starting up", "Service turtle starting up...")
restock()
report("idle at home", "Ready. Waiting for requests...", false)

local idle_since
while true do
  if #queue > 0 then
    idle_since = nil
    local job = table.remove(queue, 1)
    queued[job.id] = nil
    current_key = job.key
    serve(job) -- if this fails, the miner re-sends and we try again
    current_key = nil
  else
    -- Never wait inside a lane: a miner driving home could get stuck behind
    -- us. The home row is ours alone, so wait there.
    if sz ~= 0 then
      report("waiting on the home row", nil, false)
      go_to_z(0)
    end
    -- After a while with nothing to do, go home to empty out and refill.
    idle_since = idle_since or os.clock()
    local at_home = sx == 0 and sz == 0
    if os.clock() - idle_since >= IDLE_HOME_AFTER
        and (not at_home or not cargo_empty() or fuel_stock() < LOW_STOCK) then
      restock()
      print("Ready. Waiting for requests...")
      report("idle at home", nil, false)
      idle_since = os.clock()
    end
    local sender, msg = rednet.receive(SERVICE_PROTOCOL, 2)
    if msg then handle_message(sender, msg) end
    if os.clock() - last_report >= 20 then report() end -- heartbeat
  end
end
